{
  "name": "@fringeworks/react-components",
  "version": "0.10.0",
  "private": true,
  "description": "A collection of React components some will find handy.",
  "keywords": [
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fringeworks-js/react-components.git"
  },
  "license": "MIT",
  "author": "Mitsuhiro Seino",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.scss",
    "./button.css": "./src/Button/styles.scss",
    "./buttongroup.css": "./src/ButtonGroup/styles.scss",
    "./checkbox.css": "./src/Checkbox/styles.scss",
    "./checkboxgroup.css": "./src/CheckboxGroup/styles.scss",
    "./collapsible.css": "./src/Collapsible/styles.scss",
    "./radiogroup.css": "./src/RadioGroup/styles.scss",
    "./recordfields.css": "./src/RecordFields/styles.scss",
    "./table.css": "./src/Table/styles.scss",
    "./textinput.css": "./src/TextInput/styles.scss",
    "./*": "./src/*/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "build-storybook": "storybook build",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "indexes": "tsx ./scripts/indexes.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "pnpm build && npm publish ./dist",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "tidy": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" --config ./prettier.tidy.config.ts"
  },
  "dependencies": {
    "@fringeworks/react-contract": "^0.2.0",
    "@fringeworks/react-parts-props": "^0.9.1",
    "@fringeworks/react-primitives": "^0.2.0",
    "@fringeworks/style-layouts": "^0.10.1",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@chromatic-com/storybook": "^5.1.2",
    "@fringeworks/dev": "^0.13.3",
    "@fringeworks/react-layouts": "^0.10.1",
    "@fringeworks/react-layouts-adornment": "^0.3.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-onboarding": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@testing-library/react": "^16.3.3",
    "@tsdown/css": "^0.23.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.9.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-storybook": "^10.3.6",
    "jsdom": "^30.1.1",
    "playwright": "^1.60.0",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.105.0",
    "sass-embedded": "^1.99.0",
    "storybook": "^10.3.6",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
